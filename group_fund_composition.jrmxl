	<style name="Percent" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00'%'" fontName="SansSerif" fontSize="10.0"/>
	<style name="AngleCell" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00'°'" fontName="SansSerif" fontSize="10.0"/>
	<style name="TotalCell" mode="Opaque" backcolor="#D9E2F3" vTextAlign="Middle" fontName="SansSerif" fontSize="11.0" bold="true"/>
	<style name="TotalMoney" mode="Opaque" backcolor="#D9E2F3" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00" fontName="SansSerif" fontSize="11.0" bold="true"/>
	<style name="TotalAngle" mode="Opaque" backcolor="#D9E2F3" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00'°'" fontName="SansSerif" fontSize="11.0" bold="true"/>
	<parameter name="groupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["2"]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    g.id                                                        AS group_id,
    COALESCE(g.group_name, '')                                  AS group_name,

    COALESCE(c.total_contributions, 0)                          AS total_contributions,
    COALESCE(l.principal_out, 0)                                AS principal_out_loan,
    COALESCE(l.outstanding_interest, 0)                         AS outstanding_interest,
    COALESCE(li.interest_gained, 0)                             AS interest_gained,

    ( COALESCE(c.total_contributions, 0)
    + COALESCE(l.outstanding_interest, 0)
    + COALESCE(li.interest_gained, 0) )                         AS total_group_money,

    COALESCE(
        ROUND(COALESCE(c.total_contributions, 0) * 360.0
            / NULLIF( COALESCE(c.total_contributions, 0)
                    + COALESCE(l.outstanding_interest, 0)
                    + COALESCE(li.interest_gained, 0), 0), 2)
    , 0)                                                        AS angle_contributions,

    COALESCE(
        ROUND(COALESCE(l.principal_out, 0) * 360.0
            / NULLIF( COALESCE(c.total_contributions, 0)
                    + COALESCE(l.outstanding_interest, 0)
                    + COALESCE(li.interest_gained, 0), 0), 2)
    , 0)                                                        AS angle_principal_out_loan,

    COALESCE(
        ROUND(COALESCE(l.outstanding_interest, 0) * 360.0
            / NULLIF( COALESCE(c.total_contributions, 0)
                    + COALESCE(l.outstanding_interest, 0)
                    + COALESCE(li.interest_gained, 0), 0), 2)
    , 0)                                                        AS angle_outstanding_interest,

    COALESCE(
        ROUND(COALESCE(li.interest_gained, 0) * 360.0
            / NULLIF( COALESCE(c.total_contributions, 0)
                    + COALESCE(l.outstanding_interest, 0)
                    + COALESCE(li.interest_gained, 0), 0), 2)
    , 0)                                                        AS angle_interest_gained

FROM `groups` g
LEFT JOIN (
    SELECT group_id, SUM(amount) AS total_contributions
    FROM contributions GROUP BY group_id
) c  ON c.group_id = g.id
LEFT JOIN (
    SELECT group_id,
           SUM(principal - amount_repaid)          AS principal_out,
           SUM(interest_amount * (`is_repaid` = 0)) AS outstanding_interest
    FROM loans GROUP BY group_id
) l  ON l.group_id = g.id
LEFT JOIN (
    SELECT group_id, SUM(amount) AS interest_gained
    FROM loan_interest GROUP BY group_id
) li ON li.group_id = g.id
WHERE g.id = $P!{groupId}]]></query>
	<field name="group_id" class="java.lang.String"/>
	<field name="group_name" class="java.lang.String"/>
	<field name="total_contributions" class="java.math.BigDecimal"/>
	<field name="principal_out_loan" class="java.math.BigDecimal"/>
	<field name="outstanding_interest" class="java.math.BigDecimal"/>
	<field name="interest_gained" class="java.math.BigDecimal"/>
	<field name="total_group_money" class="java.math.BigDecimal"/>
	<field name="angle_contributions" class="java.math.BigDecimal"/>
	<field name="angle_principal_out_loan" class="java.math.BigDecimal"/>
	<field name="angle_outstanding_interest" class="java.math.BigDecimal"/>
	<field name="angle_interest_gained" class="java.math.BigDecimal"/>
