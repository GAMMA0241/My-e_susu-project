<jasperReport name="withdrawal_statement" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="4bd05aab-3f11-46f4-aa5e-028ea60a55ee">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="esusu"/>
	<parameter name="groupId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.sql.Date">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.sql.Date">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="status" class="java.lang.String">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    w.id                                          AS RequestId,
    w.PhoneNumber                                 AS PhoneNumber,
    m.FullName                                    AS MemberName,
    w.request_type                                AS RequestType,
    w.contribution                                AS Contribution,
    w.interest_share                              AS InterestShare,
    w.penalty                                     AS Penalty,
    w.amount_payable                              AS AmountPayable,
    w.status                                      AS Status,
    w.requested_on                                AS RequestedOn,
    w.processed_on                                AS ProcessedOn,
    w.processed_by                                AS ProcessedBy,
    w.notes                                       AS Notes,
    w.target_group_name                           AS TargetGroup,
    w.target_bank_account                         AS TargetBankAccount,
    w.momo_number                                 AS MomoNumber,
    DATEDIFF(CURDATE(), DATE(w.requested_on))     AS DaysPending
FROM withdrawal_requests w
INNER JOIN member m
    ON m.group_id    = w.group_id
   AND m.PhoneNumber = w.PhoneNumber
WHERE w.group_id = $P{groupId}

ORDER BY w.requested_on DESC, w.id DESC]]></query>
