<!-- Created with Jaspersoft Studio version 7.0.8.final using JasperReports Library version 7.0.8-6f896111  -->
<jasperReport name="members_total" language="java" pageWidth="595" pageHeight="842" columnWidth="565" leftMargin="15" rightMargin="15" topMargin="15" bottomMargin="15" uuid="a6d6633d-1e40-4b2f-bc00-16ddd9dde98d">
	<property name="com.jaspersoft.studio.data.default data adapter" value="esusu"/>
	<parameter name="groupId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    m.FullName                                    AS MemberName,
    m.PhoneNumber                                 AS PhoneNumber,
    m.JoinDate                                    AS JoinDate,
    m.MaturityDate                                AS MaturityDate,
    COALESCE(c.total, 0)                          AS TotalContributions,
    COALESCE(s.total, 0)                          AS TotalInterest,
    COALESCE(w.total, 0)                          AS TotalWithdrawn,
    COALESCE(l.outstanding, 0)                    AS LoanOutstanding,
    (COALESCE(c.total, 0)
     + COALESCE(s.total, 0)
     - COALESCE(w.total, 0)
     - COALESCE(l.outstanding, 0))                AS NetBalance
FROM member m
LEFT JOIN (
    SELECT group_id, PhoneNumber, SUM(amount) AS total
      FROM contributions
     GROUP BY group_id, PhoneNumber
) c ON c.group_id = m.group_id AND c.PhoneNumber = m.PhoneNumber
LEFT JOIN (
    SELECT group_id, PhoneNumber, SUM(interest_share) AS total
      FROM interest_distribution_share
     GROUP BY group_id, PhoneNumber
) s ON s.group_id = m.group_id AND s.PhoneNumber = m.PhoneNumber
LEFT JOIN (
    SELECT group_id, PhoneNumber, SUM(amount_payable) AS total
      FROM withdrawal_requests
     WHERE status = CHAR(80,65,73,68)
     GROUP BY group_id, PhoneNumber
) w ON w.group_id = m.group_id AND w.PhoneNumber = m.PhoneNumber
LEFT JOIN (
    SELECT group_id, PhoneNumber,
           SUM(principal + interest_amount - amount_repaid) AS outstanding
      FROM loans
     WHERE is_repaid = FALSE
     GROUP BY group_id, PhoneNumber
) l ON l.group_id = m.group_id AND l.PhoneNumber = m.PhoneNumber
WHERE m.group_id = $P{groupId}
ORDER BY NetBalance DESC]]></query>
