		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="GroupTotalNet" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{NetBalance}]]></expression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
