<jasperReport name="contri_statement" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="dd1762b3-a993-4aa3-b3e8-4e4fe6a9f9d0">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="esusu"/>
    <parameter name="groupId" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="phoneNumber" class="java.lang.String">
        <defaultValueExpression><![CDATA["0551334966"]]></defaultValueExpression>
    </parameter>
    <query language="SQL"><![CDATA[SELECT
    m.FullName,
    m.PhoneNumber,
    m.GhanaCardNumber,
    m.JoinDate,
    m.MaturityDate,
    m.IsActive,
    m.LeftEarly,
    m.ExitDate,
    m.group_id,
    g.group_name,
    COALESCE((SELECT SUM(c.amount) FROM contributions c
               WHERE c.group_id = m.group_id AND c.PhoneNumber = m.PhoneNumber), 0) AS TotalContributions,
    COALESCE((SELECT SUM(s.interest_share) FROM interest_distribution_share s
               WHERE s.group_id = m.group_id AND s.PhoneNumber = m.PhoneNumber), 0) AS TotalInterest,
    COALESCE((SELECT SUM(w.amount_payable) FROM withdrawal_requests w
               WHERE w.group_id = m.group_id AND w.PhoneNumber = m.PhoneNumber
                 AND w.status = 'PAID'), 0) AS TotalWithdrawn,
    COALESCE((SELECT SUM(l.principal + l.interest_amount - l.amount_repaid) FROM loans l
               WHERE l.group_id = m.group_id AND l.PhoneNumber = m.PhoneNumber
                 AND l.is_repaid = FALSE), 0) AS LoanOutstanding,
    (COALESCE((SELECT SUM(c.amount) FROM contributions c
               WHERE c.group_id = m.group_id AND c.PhoneNumber = m.PhoneNumber), 0)
     + COALESCE((SELECT SUM(s.interest_share) FROM interest_distribution_share s
               WHERE s.group_id = m.group_id AND s.PhoneNumber = m.PhoneNumber), 0)
     - COALESCE((SELECT SUM(w.amount_payable) FROM withdrawal_requests w
               WHERE w.group_id = m.group_id AND w.PhoneNumber = m.PhoneNumber
                 AND w.status = 'PAID'), 0)
     - COALESCE((SELECT SUM(l.principal + l.interest_amount - l.amount_repaid) FROM loans l
               WHERE l.group_id = m.group_id AND l.PhoneNumber = m.PhoneNumber
                 AND l.is_repaid = FALSE), 0)) AS NetBalance
FROM member m
JOIN `groups` g ON g.id = m.group_id
WHERE m.group_id    = $P{groupId}
  AND m.PhoneNumber = $P{phoneNumber}]]></query>
    <field name="FullName" class="java.lang.String"/>
    <field name="PhoneNumber" class="java.lang.String"/>
    <field name="GhanaCardNumber" class="java.lang.String"/>
    <field name="JoinDate" class="java.sql.Date"/>
