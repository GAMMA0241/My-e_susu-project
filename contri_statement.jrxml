    <field name="IsActive" class="java.lang.Boolean"/>
    <field name="LeftEarly" class="java.lang.Boolean"/>
    <field name="ExitDate" class="java.sql.Date"/>
    <field name="group_id" class="java.lang.Integer"/>
    <field name="group_name" class="java.lang.String"/>
    <field name="TotalContributions" class="java.math.BigDecimal"/>
    <field name="TotalInterest" class="java.math.BigDecimal"/>
    <field name="TotalWithdrawn" class="java.math.BigDecimal"/>
    <field name="LoanOutstanding" class="java.math.BigDecimal"/>
    <field name="NetBalance" class="java.math.BigDecimal"/>
